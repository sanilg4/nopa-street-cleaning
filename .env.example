# Security / Access Control
APP_PIN=1234

# Telegram Bot Integration
# 1. Message @BotFather on Telegram to create your bot and get the token
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# 2. Create a group with you, your girlfriend, and the bot.
# Add @RawDataBot or forward a message to get your group chat ID (starts with a minus sign, e.g. -100123456789)
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Supabase Database (PostgreSQL)
# Create a free project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_or_anon_key

# Optional: Vercel Cron Security
CRON_SECRET=
